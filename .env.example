# 应用配置
APP_NAME=零售平台
APP_VERSION=0.1.0
DEBUG=true

# 数据库配置 (默认使用SQLite)
DATABASE_URL=sqlite+aiosqlite:///./retail_platform.db

# 如需使用PostgreSQL,取消以下注释
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/retail_db

# JWT配置
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 分页配置
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
